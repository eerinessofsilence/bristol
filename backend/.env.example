APP_NAME=ClearGateCustoms API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://cleargatecustoms:cleargatecustoms@localhost:5432/cleargatecustoms
CORS_ORIGINS=http://localhost:5173
NBU_EXCHANGE_RATE_URL=https://bank.gov.ua/NBUStatService/v1/statdirectory/exchange?valcode=USD&json
NBU_TIMEOUT_SECONDS=5
NBU_CACHE_TTL_HOURS=12
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_TIMEOUT_SECONDS=45
PRODUCT_CODE_AI_REQUESTS_PER_MINUTE=5
PRODUCT_CODE_AI_MAX_CONCURRENT=2

# Сповіщення про нові заявки. Залиште EMAIL_NOTIFICATIONS_ENABLED=false,
# доки корпоративну пошту та SMTP-доступ не налаштовано.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=info@cleargatecustoms.com.ua
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=info@cleargatecustoms.com.ua
LEAD_NOTIFICATION_EMAIL=info@cleargatecustoms.com.ua
